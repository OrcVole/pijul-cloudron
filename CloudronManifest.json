  "mediaLinks": ["https://raw.githubusercontent.com/OrcVole/pijul-cloudron/main/screenshots/repo-file-browser.png", "https://raw.githubusercontent.com/OrcVole/pijul-cloudron/main/screenshots/login-page.png"],
